FROM python:3.12-slim

WORKDIR /app

# Instalar Node.js, unzip (Requerido por Reflex/Bun) y dependencias base
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    unzip \
    git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependencias del frontend
COPY requirements-frontend.txt .
RUN pip install --no-cache-dir -r requirements-frontend.txt

# Copiar la aplicación Reflex
COPY ticket_triage_ui/ .

WORKDIR /app

# Inicializar reflex (ahora podrá descomprimir Bun sin errores)
RUN reflex init

EXPOSE 3000

CMD ["reflex", "run", "--env", "prod", "--backend-port", "8002"]